<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kartoules - My Collection</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0d0d14;
      color: #c9d1d9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      min-height: 100vh;
    }

    header {
      background: #11111c;
      border-bottom: 1px solid #2a2a3d;
      padding: 0 24px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand { font-size: 20px; font-weight: 700; color: #f0f6fc; text-decoration: none; }
    .brand em { font-style: normal; color: #a371f7; }

    nav { display: flex; align-items: center; gap: 16px; font-size: 13px; }
    nav span { color: #8b949e; }
    nav strong { color: #c9d1d9; }
    nav a { color: #8b949e; text-decoration: none; padding: 5px 10px; border-radius: 6px; transition: background 0.15s, color 0.15s; }
    nav a:hover { background: #21262d; color: #c9d1d9; }

    main { max-width: 1100px; margin: 36px auto; padding: 0 24px; }

    .section-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #6e7681;
      margin-bottom: 16px;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 48px;
    }

    .card-item {
      background: #11111c;
      border: 1px solid #2a2a3d;
      border-radius: 10px;
      overflow: hidden;
      transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
    }

    .card-item:hover {
      border-color: #a371f7;
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(163, 113, 247, 0.15);
    }

    .card-item a { display: block; text-decoration: none; }

    .card-thumb {
      background: #0d0d14;
      border-bottom: 1px solid #1e1e2e;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 220px;
      overflow: hidden;
    }

    .card-thumb img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }

    .card-footer { padding: 10px 12px; }
    .card-footer .fname {
      font-size: 12px;
      font-weight: 600;
      color: #8b949e;
      font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    }

  </style>
</head>
<body>
  <header>
    <a class="brand" href="/gallery">Kartoules</a>
    <nav>
      <span>Signed in as <strong><%= username %></strong></span>
      <a href="/logout">Sign out</a>
    </nav>
  </header>

  <main>
    <p class="section-label">My Collection</p>
    <div class="card-grid">
      <% images.forEach(function(img) { %>
        <div class="card-item">
          <a href="/image?file=<%= encodeURIComponent(img) %>" target="_blank" rel="noopener">
            <div class="card-thumb">
              <img src="/image?file=<%= encodeURIComponent(img) %>" alt="<%= img %>">
            </div>
            <div class="card-footer">
              <span class="fname"><%= img %></span>
            </div>
          </a>
        </div>
      <% }); %>
    </div>

  </main>
</body>
</html>
