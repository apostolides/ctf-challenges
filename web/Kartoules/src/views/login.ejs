<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kartoules - Login</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0d0d14;
      color: #c9d1d9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 360px;
      padding: 0 16px;
    }

    .logo {
      text-align: center;
      margin-bottom: 24px;
    }

    .logo h1 {
      font-size: 28px;
      font-weight: 700;
      color: #f0f6fc;
      letter-spacing: -0.5px;
    }

    .logo h1 em {
      font-style: normal;
      color: #a371f7;
    }

    .logo p {
      margin-top: 6px;
      font-size: 13px;
      color: #8b949e;
    }

    .card {
      background: #161b22;
      border: 1px solid #30363d;
      border-radius: 10px;
      padding: 28px 28px 24px;
    }

    .card h2 {
      font-size: 18px;
      font-weight: 600;
      color: #f0f6fc;
      margin-bottom: 20px;
      text-align: center;
    }

    .alert {
      background: #3d1c1c;
      border: 1px solid #6e2020;
      border-radius: 6px;
      color: #ff7b72;
      font-size: 13px;
      padding: 10px 14px;
      margin-bottom: 16px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #c9d1d9;
      margin-bottom: 6px;
    }

    input[type="text"],
    input[type="password"] {
      width: 100%;
      background: #0d1117;
      border: 1px solid #30363d;
      border-radius: 6px;
      color: #c9d1d9;
      font-size: 14px;
      padding: 8px 12px;
      outline: none;
      transition: border-color 0.15s;
      margin-bottom: 14px;
    }

    input[type="text"]:focus,
    input[type="password"]:focus {
      border-color: #a371f7;
      box-shadow: 0 0 0 3px rgba(163, 113, 247, 0.15);
    }

    button[type="submit"] {
      width: 100%;
      background: #6e40c9;
      border: 1px solid #a371f7;
      border-radius: 6px;
      color: #f0f6fc;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      padding: 9px 0;
      transition: background 0.15s;
      margin-top: 4px;
    }

    button[type="submit"]:hover { background: #8957e5; }

    .footer-link {
      text-align: center;
      margin-top: 16px;
      font-size: 13px;
      color: #8b949e;
    }

    .footer-link a {
      color: #a371f7;
      text-decoration: none;
    }

    .footer-link a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">
      <h1>Kartoules</h1>
      <p>Magic: The Gathering collection tracker</p>
    </div>

    <div class="card">
      <h2>Sign in</h2>

      <% if (error) { %>
        <div class="alert"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" autocomplete="username" required>

        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>

        <button type="submit">Sign in</button>
      </form>
    </div>

    <div class="footer-link">
      New to Kartoules? <a href="/register">Create an account</a>
    </div>
  </div>
</body>
</html>
