<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Post - Lock Talk Forums</title>
  <link rel="icon" href="/img/favicon.svg">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('_nav') %>
  <div class="layout layout-narrow">
    <main>
      <h2 style="margin-bottom:1.25rem">Create a Post</h2>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <div class="form-card">
        <form method="POST" action="/submit">
          <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" maxlength="300" placeholder="Give your post a descriptive title" required autofocus>
          </div>
          <div class="form-group">
            <label for="body">Body</label>
            <textarea id="body" name="body" rows="12" placeholder="Share your picks, techniques, lock reviews, or questions…"></textarea>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">Post</button>
            <a href="/" class="btn-outline">Cancel</a>
          </div>
        </form>
      </div>
    </main>
  </div>
  <footer><p>Lock Talk Forums &copy; 2026</p></footer>
</body>
</html>
