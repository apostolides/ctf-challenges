<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Lock Talk Forums</title>
  <link rel="icon" href="/img/favicon.svg">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('_nav', { user: null }) %>
  <div class="layout layout-narrow">
    <main>
      <h2 style="margin-bottom:1.25rem">Create an Account</h2>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <div class="form-card">
        <form method="POST" action="/register">
          <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" autocomplete="username" required autofocus>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required>
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" autocomplete="new-password" required>
          </div>
          <div class="form-group">
            <label for="confirm">Confirm Password</label>
            <input type="password" id="confirm" name="confirm" autocomplete="new-password" required>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">Register</button>
          </div>
        </form>
      </div>
      <p style="margin-top:1rem;text-align:center;font-size:.9rem">
        Already have an account? <a href="/login">Sign in</a>
      </p>
    </main>
  </div>
  <footer><p>Lock Talk Forums &copy; 2026</p></footer>
</body>
</html>
